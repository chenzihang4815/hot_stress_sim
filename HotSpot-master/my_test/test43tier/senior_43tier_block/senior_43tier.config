# HotSpot configuration for 43 laboratory tiers on one 2D floorplan.
# Dimensions are SI units; power values in the .ptrace file are watts.

# Silicon chip layer
-t_chip                 0.00015
-k_chip                 130.0
-p_chip                 1630300

# Heat sink and package
-c_convec               140.4
-r_convec               0.1
-s_sink                 0.06
-t_sink                 0.0069
-k_sink                 400.0
-p_sink                 3.55e6
-s_spreader             0.04
-t_spreader             0.001
-k_spreader             400.0
-p_spreader             3.55e6
-t_interface            2.0e-05
-k_interface            4.0
-p_interface            4.0e6

# Ambient and simulation settings
-ambient                318.15
-init_file              (null)
-init_temp              318.15
-steady_file            senior_43tier.steady
-sampling_intvl         0.01
-base_proc_freq         3e9
-dtm_used               0
-model_type             block
-leakage_used           0
-leakage_mode           0
-package_model_used    0
-package_config_file    package.config
-block_omit_lateral     0

# Unused grid/microfluidic options retained for explicitness
-model_secondary        0
-grid_rows              64
-grid_cols              64
-grid_layer_file        (null)
-grid_steady_file       (null)
-grid_map_mode          avg
-use_microfluidic_cooling 0
